# Pasta de dados (progresso, certificados e segredo). Use ":memory:" para não persistir nada.
# GEO_DATA_DIR=~/.geo-explorer

# Segredo HMAC das assinaturas dos certificados (>= 16 caracteres).
# Se vazio, é gerado em <GEO_DATA_DIR>/secret.key (permissão 0600).
# GEO_CERT_SECRET=

# true = só emite certificados quando o progresso registrado comprova a conclusão.
# GEO_STRICT_CERTIFICATES=false

# Nota mínima (1-100) para aprovar um desafio.
# GEO_PASS_SCORE=70

# debug | info | warn | error | silent  (logs sempre em stderr)
# GEO_LOG_LEVEL=info

# Fuso IANA das datas exibidas nos certificados.
# GEO_TIMEZONE=America/Sao_Paulo
