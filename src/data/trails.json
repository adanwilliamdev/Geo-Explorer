      { "id": "typescript-conditional-types", "name": "Conditional Types e infer", "level": "avancado", "hours": 7, "topics": ["conditional types", "infer", "tipos recursivos"], "prerequisites": ["typescript-generics", "typescript-unions-narrowing"] },
