      { "id": "java-jpa-hibernate", "name": "JPA/Hibernate", "level": "avancado", "hours": 12, "topics": ["mapeamento de entidades", "relacionamentos", "transações e problema N+1"], "prerequisites": ["java-spring-boot"] },
      { "id": "java-microsservicos", "name": "Microsserviços", "level": "avancado", "hours": 16, "topics": ["comunicação síncrona e assíncrona", "API Gateway", "resiliência e circuit breaker"], "prerequisites": ["java-spring-boot", "java-junit"] }
