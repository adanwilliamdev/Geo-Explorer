      { "id": "java-poo", "name": "POO (Programação Orientada a Objetos)", "level": "intermediario", "hours": 10, "topics": ["classes e objetos", "herança e polimorfismo", "encapsulamento e interfaces"], "prerequisites": ["java-estruturas-controle"] },
